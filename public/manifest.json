{
  "manifest_version": 3,
  "name": "Manga Translator",
  "version": "0.1.0",
  "description": "Manga ve webtoon görsellerindeki metinleri algılar ve Türkçeye çevirir.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.mymemory.translated.net/*",
    "https://tessdata.projectnaptha.com/*"
  ],
  "action": {
    "default_title": "Manga Translator",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}